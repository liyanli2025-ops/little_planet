# Generate your actual .env with python3 scripts/configure.py --origin http://YOUR_SERVER_IP:8081
PUBLIC_ORIGIN=http://YOUR_SERVER_IP:8081
HOST_PORT=8081
BIND_ADDRESS=0.0.0.0
# The first resident chooses the join code in the app. No generated code is needed.

# AI design is disabled until the owner configures their provider account.
AI_DESIGN_ENABLED=false
AI_API_KEY=
# Copy the OpenAI-compatible base URL and model ID from your provider console.
AI_BASE_URL=
AI_MODEL=
AI_DESIGN_DAILY_LIMIT=5
AI_DESIGN_GLOBAL_DAILY_LIMIT=50
